{
  "name": "drupal/sshkey",
  "type": "drupal-module",
  "description": "Provides a new field type to collect a ssh public keys.",
  "keywords": [
    "Drupal"
  ],
  "license": "GPL-2.0-or-later",
  "homepage": "https://drupal.org/project/sshkey",
  "repositories": {
    "0": {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    },
    "1": {
      "type": "composer",
      "url": "https://asset-packagist.org"
    }
  },
  "require-dev": {
    "dropfort/dropfort_module_build": "^2.0",
    "drush/drush": "*"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "bin-dir": "bin/",
    "sort-packages": true,
    "github-protocols": [
      "https"
    ],
    "allow-plugins": {
      "drupal/core-composer-scaffold": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "extra": {
    "drupal-scaffold": {
      "gitignore": false,
      "allowed-packages": [
        "dropfort/dropfort_module_build"
      ],
      "file-mapping": {
        "[project-root]/.postcssrc.js": false,
        "[project-root]/.stylelintignore": false,
        "[project-root]/.stylelintrc.js": false,
        "[project-root]/rollup.config.js": false
      },
      "initial": {
        ".editorconfig": "../.editorconfig",
        ".gitattributes": "../.gitattributes"
      },
      "locations": {
        "web-root": "drupal-ignore/"
      }
    },
    "enable-patching": true,
    "patches": {}
  },
  "require": {
    "phpseclib/phpseclib": "^3.0"
  }
}
